#!/usr/bin/env bash
# Screenshots of the real app, offscreen, on fixtures: no window appears and
# no real deck, wiki or log is read or written (bin/sandbox). Prints each PNG;
# read them.
#
#   bin/shot                          home, 1440x900
#   bin/shot -s study -a answer       a session, an answer typed and revealed
#   bin/shot -s wiki:web/http-caching -w 720
#   bin/shot -a search:csrf           the palette with results
#
#   -s  home | study | wiki | cards | graph | wiki:<path> | folder:<path>
#   -a  search[:text] | ask[:question] | add[:flashcard|wiki] | addmenu |
#       study | answer[:text] | pagecards | cardsnext[:n] | cardsflip |
#       cardstags:<tag,tag> (picked) | cardspanel[:<tag,tag>] (the tag panel) |
#       cardsdelete | studydelete (Del's dialog, left open) |
#       done (rate all Good: the summary) | leech (a blocked session) |
#       syncfail (a card up, the sync's failure note) | keys (the key list)
#       undo (a rating undone, its card back) | undokeys (the key list over it) |
#       accept[:1-4] (an answer revealed, then rated: catch it with -f) |
#       graphlocal (the graph screen around the page -s opened) |
#       panels[:side,graph] (on a wiki page: fold the side panel, open the graph) |
#       note[:text] (the note dialog over a card, never saved) |
#       notes[:cards] (notes and a past session in the deck; :cards picks "noted") |
#       studypages (the wiki panel's "From study" list) |
#       code:<predict|fill|compose>[:wrong|pass|error|giveup] (a code card; -f catches its animation)
#   -w/-h size, -f frames (ms, comma-separated), -t settle ms, -o out dir
#   -R  your real wiki and deck instead of the fixtures, to see the layout at
#       full size. Read-only by construction: it refuses the Study screen and
#       every action that could write (study, answer, undo, undokeys, ask, add, done, leech,
#       syncfail), and the fake claude and kitty stay first on PATH.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
screen=home width=1440 height=900 action="" frames=0 settle=2500
out="${TMPDIR:-/tmp}/omvida-shots"
real=0
while getopts "s:w:h:a:f:t:o:R" opt; do
  case "$opt" in
    R) real=1 ;;
    s) screen=$OPTARG ;; w) width=$OPTARG ;; h) height=$OPTARG ;; a) action=$OPTARG ;;
    f) frames=$OPTARG ;; t) settle=$OPTARG ;; o) out=$OPTARG ;;
    *) sed -n '2,/^[^#]/{/^#/p}' "$0"; exit 2 ;;
  esac
done
mkdir -p "$out"
export QT_QPA_PLATFORM=offscreen OMVIDA_SHOT_DIR="$out" OMVIDA_SHOT_SCREEN="$screen" \
  OMVIDA_SHOT_ACTION="$action" OMVIDA_SHOT_WIDTH="$width" OMVIDA_SHOT_HEIGHT="$height" \
  OMVIDA_SHOT_FRAMES="$frames" OMVIDA_SHOT_SETTLE="$settle"
launcher=("$ROOT/bin/omvida")
if [ "$real" = 1 ]; then
  case "$screen" in study) echo "bin/shot: -R refuses the Study screen (it starts a session)" >&2; exit 2 ;; esac
  # Only actions known to read nothing back: a new action is refused under
  # -R until it is added here, rather than allowed until someone remembers.
  case "${action%%:*}" in ""|search|addmenu|pagecards|cardsnext|cardsflip|cardstags|cardspanel|graphlocal|panels|studypages) ;;
    *) echo "bin/shot: -R refuses -a $action (it could write)" >&2; exit 2 ;; esac
  export PATH="$ROOT/tests/fixtures/bin:$PATH" OMVIDA_TEST_OUT="${TMPDIR:-/tmp}"
  # No Study, so no grade; a fake key still keeps bin/omvida-deck out of the
  # keyring (an unlock prompt), and a closed port keeps any grade off the API.
  export ANTHROPIC_API_KEY="shot-fake-key" ANTHROPIC_BASE_URL="http://127.0.0.1:9"
else
  box="$(mktemp -d "${TMPDIR:-/tmp}/omvida-shot.XXXXXX")"
  trap 'rm -rf -- "$box"' EXIT
  launcher=("$ROOT/bin/sandbox" "$box" -- "$ROOT/bin/omvida")
fi
timeout 60 "${launcher[@]}" --no-color 2>&1 \
  | grep -vE 'WAYLAND_DISPLAY is present|actually running wayland|--- WARNING ---|window masks' \
  | sed -n 's/.*\[omvida-shot\] //p; /WARN\|ERROR\|rror:/p' || true
