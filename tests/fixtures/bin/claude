#!/usr/bin/env bash
# A stand-in for `claude` in the app tests and screenshots: no network, no
# cost, the same output shapes. Every call is recorded in
# $OMVIDA_TEST_OUT/claude-calls.jsonl. (Grading is not claude's: the deck
# server calls the API, faked by tests/fixtures/fake-anthropic.py.)
#
#   a card check (`/study-card-check <id>`, Ctrl+Q): one json result with the
#     skill's structured report, saying the card is sound, after 0.5s (3s while
#     the file $OMVIDA_TEST_OUT/slow-card-check exists); a split when the file
#     $OMVIDA_TEST_OUT/split-card-check exists, a failure with bad-card-check
#   asking (stream-json): a short streamed answer with a wikilink, one tool
#     call, and a result carrying a session id; 2s first for a question with
#     "slowly"
set -euo pipefail
out="${OMVIDA_TEST_OUT:-/tmp}"
python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@" >>"$out/claude-calls.jsonl"
case " $* " in
  *" /study-card-check "*)
    if [ -e "$out/slow-card-check" ]; then sleep 3; else sleep 0.5; fi
    prompt="$2"   # claude -p <prompt> ...
    id="${prompt#/study-card-check }"
    if [ -e "$out/bad-card-check" ]; then
      echo '{"type":"result","subtype":"error_max_turns","is_error":true,"result":"ran out of turns"}'
    elif [ -e "$out/split-card-check" ]; then
      python3 -c 'import json; print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": "done", "structured_output": {"outcome": "split", "summary": "It asked two things, so each has its own card now.", "asked": ["what an ETag is", "which header revalidates it"], "extra": ["a date nobody asked for"], "cards": [{"front": "What is an ETag?", "back": "A version tag for a response."}, {"front": "Which header revalidates an ETag?", "back": "<code>If-None-Match</code>."}]}}))'
    else
      python3 -c 'import json,sys; print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": "done", "structured_output": {"outcome": "no_change", "summary": "Fixture card " + sys.argv[1] + " is sound.", "asked": ["one thing"], "extra": [], "cards": []}}))' "$id"
    fi
    ;;
  *" stream-json "*)
    case "$*" in *slowly*) sleep 2 ;; esac
    printf '%s\n' '{"type":"system","subtype":"init","session_id":"fake-session-1"}'
    printf '%s\n' '{"type":"stream_event","event":{"type":"content_block_start","content_block":{"type":"text","text":""}}}'
    printf '%s\n' '{"type":"stream_event","event":{"type":"content_block_delta","delta":{"type":"text_delta","text":"An origin is scheme, host and port. "}}}'
    printf '%s\n' '{"type":"stream_event","event":{"type":"content_block_start","content_block":{"type":"tool_use","name":"mcp__qmd__query"}}}'
    sleep 0.2
    printf '%s\n' '{"type":"stream_event","event":{"type":"content_block_start","content_block":{"type":"text","text":""}}}'
    printf '%s\n' '{"type":"stream_event","event":{"type":"content_block_delta","delta":{"type":"text_delta","text":"**Saved knowledge**: [[security/csrf]] covers it."}}}'
    printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"session_id":"fake-session-1","result":"ok"}'
    ;;
  *) echo "fake claude: interactive run recorded" ;;
esac
