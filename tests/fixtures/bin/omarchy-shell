#!/usr/bin/env bash
# A stand-in for omarchy-shell in the app tests: records its argv, reaches no
# shell. The app hands the bar its overview through it (Store.onOverviewChanged).
python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@" >>"${OMVIDA_TEST_OUT:-/tmp}/omarchy-shell-calls.jsonl"
